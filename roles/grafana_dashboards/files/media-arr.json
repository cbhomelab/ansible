     "type": "prometheus",
     "uid": "prometheus"
    },
    "query": {
     "query": "label_values(container_last_seen{name=~\"plex|jellyfin|tautulli|seerr|sonarr|radarr|lidarr|bazarr|prowlarr|whisparr|huntarr-.*|lidarr-hunter|sabnzbd|qbittorrent|gluetun.*|tdarr.*|tidarr|aurral|tunarr|dispatcharr|ytdl-sub|flaresolverr|romm|stash|socks5_.*\"}, name)",
     "refId": "v"
    },
    "refresh": 2,
    "multi": true,
    "includeAll": true,
    "sort": 1,
    "current": {
     "selected": true,
     "text": "All",
     "value": "$__all"
    },
    "definition": "label_values(container_last_seen{name=~\"plex|jellyfin|tautulli|seerr|sonarr|radarr|lidarr|bazarr|prowlarr|whisparr|huntarr-.*|lidarr-hunter|sabnzbd|qbittorrent|gluetun.*|tdarr.*|tidarr|aurral|tunarr|dispatcharr|ytdl-sub|flaresolverr|romm|stash|socks5_.*\"}, name)",
    "allValue": ".+"
   }
  ]
 },
