  {
   "id": 3,
   "type": "stat",
   "title": "OPNsense log lines (5m)",
   "datasource": {
    "type": "loki",
    "uid": "P8E80F9AEF21F6940"
   },
   "targets": [
    {
     "expr": "sum(count_over_time({host=\"router.lan.cbho.me\"}[5m]))",
     "refId": "A",
     "datasource": {
      "type": "loki",
      "uid": "P8E80F9AEF21F6940"
     },
     "legendFormat": "",
     "queryType": "range"
    }
   ],
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 0,
    "y": 1
   },
   "fieldConfig": {
    "defaults": {
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "green",
        "value": 1
       }
      ]
     },
     "color": {
      "mode": "thresholds"
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background",
    "graphMode": "none"
   },
   "description": "0 = router has stopped shipping logs"
  },
