# Managed by Ansible (roles/iracing_tms_docker). Credentials for postgres_exporter (same DB user as the app).
{% set e = itd_env_plain | combine(itd_env_overrides) %}
DATA_SOURCE_NAME=postgresql://{{ e.POSTGRES_USER }}:{{ itd_secrets.POSTGRES_PASSWORD | urlencode }}@db:5432/{{ e.POSTGRES_DB }}?sslmode=disable
