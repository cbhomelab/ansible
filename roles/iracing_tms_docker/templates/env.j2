# Managed by Ansible (roles/iracing_tms_docker). Edit the role defaults / Bitwarden, not this file.
{% set e = itd_env_plain | combine(itd_env_overrides) %}
{% for k in e | sort %}
{{ k }}={{ e[k] }}
{% endfor %}
DATABASE_URL=postgresql+psycopg2://{{ e.POSTGRES_USER }}:{{ itd_secrets.POSTGRES_PASSWORD | urlencode }}@db:5432/{{ e.POSTGRES_DB }}
{% for k in itd_vault_required + itd_vault_optional %}
{% if itd_secrets[k] | length > 0 %}
{{ k }}={{ itd_secrets[k] }}
{% endif %}
{% endfor %}
{% if itd_mumble %}
MUMBLE_ICE_SECRET={{ itd_secrets.MUMBLE_ICE_SECRET }}
MUMBLE_SERVER_PASSWORD={{ itd_secrets.MUMBLE_SERVER_PASSWORD }}
{% endif %}
