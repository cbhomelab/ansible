# Seeded by Ansible (roles/iracing_tms). Edit freely: this file is never overwritten.
# Add IRACING_*/DISCORD_* settings here (see the app's .env.example), then: systemctl restart iracing-tms
APP_ENV=production
DEBUG=false
LOG_LEVEL=INFO
SECRET_KEY={{ lookup('ansible.builtin.password', '/dev/null', length=64, chars=['ascii_letters','digits']) }}
APP_PORT={{ iracing_tms_port }}
APP_BIND={{ iracing_tms_bind }}
ADMIN_USERNAME=admin
ADMIN_PASSWORD={{ lookup('ansible.builtin.password', '/dev/null', length=20, chars=['ascii_letters','digits']) }}
POSTGRES_DB={{ iracing_tms_db }}
POSTGRES_USER={{ iracing_tms_db_user }}
POSTGRES_PASSWORD={{ _tms_pgpw }}
DATABASE_URL=postgresql+psycopg2://{{ iracing_tms_db_user }}:{{ _tms_pgpw }}@127.0.0.1:5432/{{ iracing_tms_db }}
DISCORD_BOT_ENABLED=false
SCHEDULER_ENABLED=true
SCHEDULER_SYNC_INTERVAL_HOURS=6
SCHEDULER_SCRAPER_INTERVAL_HOURS=24
SCRAPER_REQUEST_DELAY=1.0
