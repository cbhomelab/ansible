# Managed by Ansible (roles/blackbox)
modules:
  # Any answer below 500 counts as "up" (apps often redirect to login or return 401/403 unauthenticated).
  http_up:
    prober: http
    timeout: 10s
    http:
      valid_status_codes: [200, 201, 202, 204, 301, 302, 303, 307, 308, 400, 401, 403, 404]
      follow_redirects: true
      fail_if_not_ssl: true
      preferred_ip_protocol: ip4
  tcp_connect:
    prober: tcp
    timeout: 5s
    tcp: {preferred_ip_protocol: ip4}
