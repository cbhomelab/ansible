# Managed by Ansible (roles/blackbox)
groups:
  - name: homelab-probes
    rules:
      - alert: ServiceProbeDown
        expr: probe_success{job="blackbox-https"} == 0
        for: 5m
        labels: {severity: warning}
        annotations: {summary: "{{ '{{' }} $labels.name {{ '}}' }} ({{ '{{' }} $labels.instance {{ '}}' }}) failed its HTTPS probe for 5m"}
      - alert: TlsCertExpiringSoon
        expr: (probe_ssl_earliest_cert_expiry{job="blackbox-https"} - time()) < 14 * 86400
        for: 1h
        labels: {severity: warning}
        annotations: {summary: "TLS cert for {{ '{{' }} $labels.instance {{ '}}' }} expires in under 14 days (auto-renewal likely broken)"}
      - alert: TlsCertExpiryCritical
        expr: (probe_ssl_earliest_cert_expiry{job="blackbox-https"} - time()) < 5 * 86400
        for: 15m
        labels: {severity: critical}
        annotations: {summary: "TLS cert for {{ '{{' }} $labels.instance {{ '}}' }} expires in under 5 days"}
      - alert: WanUnreachable
        expr: sum(probe_success{job="blackbox-wan"}) == 0
        for: 3m
        labels: {severity: critical}
        annotations: {summary: "No internet reachability from saturn (both 1.1.1.1:443 and 9.9.9.9:443 failed)"}
      - alert: BlackboxProbesMissing
        expr: absent(probe_success{job="blackbox-https"})
        for: 30m
        labels: {severity: warning}
        annotations: {summary: "No blackbox probe results are being reported"}
