#!/bin/bash
# Managed by Ansible (roles/homeassistant). Daily HA drift/backup-freshness report.
# On failure pushes a HomeAssistantReportFailed alert to Alertmanager (-> Discord),
# valid for 26h so the next daily run refreshes it; it resolves itself once runs pass.
set -u
cd {{ homeassistant_repo_dir }} && git pull --ff-only -q 2>&1 | tail -2
out=$(ansible-playbook playbooks/homeassistant.yml 2>&1); rc=$?
am={{ homeassistant_alertmanager_url }}/api/v2/alerts
if [ $rc -ne 0 ]; then
  msg=$(printf '%s' "$out" | grep -E 'fatal|fail_msg|FAILED|msg' | head -3 | tr -d '"\\' | cut -c1-300)
  end=$(date -u -d '+26 hours' +%Y-%m-%dT%H:%M:%SZ)
  curl -s -m10 -X POST -H 'Content-Type: application/json' "$am" -d "[{\"labels\":{\"alertname\":\"HomeAssistantReportFailed\",\"severity\":\"warning\",\"host\":\"vm101-homeassistant\"},\"annotations\":{\"summary\":\"Home Assistant report failed (unhealthy supervisor, stale backup, or API unreachable): ${msg}\"},\"endsAt\":\"$end\"}]" >/dev/null
fi
exit $rc
