#!/bin/bash
# Managed by Ansible (roles/homeassistant). Daily HA drift/backup-freshness report.
# On failure pushes a HomeAssistantReportFailed alert to Alertmanager (-> Mattermost #alerts),
# valid for 26h so the next daily run refreshes it; it resolves itself once runs pass.
set -u
export PATH="$HOME/.local/bin:/usr/local/bin:/usr/bin:/bin"
cd {{ homeassistant_repo_dir }} && git pull --ff-only -q 2>&1 | tail -2
out=$(ansible-playbook playbooks/homeassistant.yml 2>&1); rc=$?
am={{ homeassistant_alertmanager_url }}/api/v2/alerts
if [ $rc -ne 0 ]; then
  printf '%s' "$out" | python3 -c '
import sys,json,re,datetime
o=sys.stdin.read()
f=re.findall(r"HA unhealthy[^\"\n]*",o) or re.findall(r"fatal: [^\n]{0,200}",o)
m=f[0] if f else o.strip()[-200:]
end=(datetime.datetime.now(datetime.timezone.utc)+datetime.timedelta(hours=26)).strftime("%Y-%m-%dT%H:%M:%SZ")
print(json.dumps([{"labels":{"alertname":"HomeAssistantReportFailed","severity":"warning","host":"vm101-homeassistant"},
 "annotations":{"summary":"Home Assistant daily report failed (unhealthy supervisor, stale backup, or API unreachable): "+m},"endsAt":end}]))' \
  | curl -s -m10 -X POST -H 'Content-Type: application/json' "$am" -d @- >/dev/null
fi
exit $rc
