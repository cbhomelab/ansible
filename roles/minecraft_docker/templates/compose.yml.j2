# Managed by Ansible (roles/minecraft_docker). Paper shares the proxy's network namespace so the
# framework's 127.0.0.1:25501 backend address works unchanged.
name: minecraft
services:
  proxy:
    build: .
    image: minecraft-runtime:{{ minecraft_docker_java }}
    container_name: minecraft-proxy
    restart: unless-stopped
    user: "{{ minecraft_docker_uid }}:{{ minecraft_docker_gid }}"
    working_dir: /var/lib/minecraft/deploy/proxy
    command: ["./start.sh"]
    environment: {HOME: /var/lib/minecraft, TZ: America/Los_Angeles}
    volumes: ["{{ minecraft_docker_data }}:/var/lib/minecraft"]
    ports:
      - "{{ minecraft_docker_proxy_port }}:25565"
      - "{{ minecraft_docker_mux_port }}:25566"
      - "{{ minecraft_docker_bluemap_port }}:8100"
{% if minecraft_docker_bedrock %}
      - "{{ minecraft_docker_geyser_port }}:19132/udp"
      - "{{ minecraft_docker_geyser_port }}:19132/tcp"
      - "{{ minecraft_docker_geyser_webrtc_port }}:19134/udp"
{% endif %}
    mem_limit: {{ minecraft_docker_mem_limit }}
    dns: {{ minecraft_docker_dns | to_json }}
  server:
    image: minecraft-runtime:{{ minecraft_docker_java }}
    container_name: minecraft-server
    restart: unless-stopped
    user: "{{ minecraft_docker_uid }}:{{ minecraft_docker_gid }}"
    working_dir: /var/lib/minecraft/deploy/server
    command: ["../contrib/server_loop.py", "--block", "start.block", "./start.sh", ":POST:", "./backup.sh"]
    network_mode: "service:proxy"
    depends_on: [proxy]
    tty: true
    stdin_open: true
    stop_grace_period: 90s
    environment: {HOME: /var/lib/minecraft, TZ: America/Los_Angeles}
    volumes: ["{{ minecraft_docker_data }}:/var/lib/minecraft"]
{% if minecraft_docker_bedrock and minecraft_docker_bedrockconnect %}
  bedrockconnect:
    image: pugmatt/bedrock-connect:latest
    container_name: minecraft-bedrockconnect
    restart: unless-stopped
    environment: {NODB: "true", CUSTOM_SERVERS: /config/custom_servers.json, TZ: America/Los_Angeles}
    volumes: ["./bedrockconnect:/config:ro"]
    ports:
      - "{{ minecraft_docker_bedrockconnect_port }}:19132/udp"
{% endif %}
