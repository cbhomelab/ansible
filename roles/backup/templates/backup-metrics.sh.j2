#!/bin/bash
# Managed by Ansible (roles/backup). Newest-backup timestamps for Prometheus.
set -u
OUT={{ backup_metrics_textfile_dir }}/homelab_backup.prom; T=$(mktemp "$OUT.XXXX")
{
echo '# TYPE homelab_backup_last_success_timestamp_seconds gauge'
for id in $(ls {{ backup_vzdump_dir }} 2>/dev/null | sed -nE 's/^vzdump-(lxc|qemu)-([0-9]+)-.*\.(tar|vma)\.zst$/\2/p' | sort -u); do
  f=$(ls -t {{ backup_vzdump_dir }}/vzdump-*-$id-*.zst 2>/dev/null | head -1)
  echo "homelab_backup_last_success_timestamp_seconds{kind=\"vzdump\",target=\"$id\"} $(stat -c %Y "$f")"
done
f=$(ls -t {{ backup_neptune_config_dir }}/neptune-config-*.tar.zst 2>/dev/null | head -1)
[ -n "$f" ] && echo "homelab_backup_last_success_timestamp_seconds{kind=\"pve-config\",target=\"neptune\"} $(stat -c %Y "$f")"
[ -f {{ backup_metrics_textfile_dir }}/.borg_last_ok ] && while read n t; do
  echo "homelab_backup_last_success_timestamp_seconds{kind=\"borg\",target=\"$n\"} $t"; done < {{ backup_metrics_textfile_dir }}/.borg_last_ok
} > "$T"
chmod 644 "$T"; mv "$T" "$OUT"
