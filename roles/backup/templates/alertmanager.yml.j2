# Managed by Ansible (roles/backup). Webhook URL is read from a file, not stored here.
# Mattermost incoming webhooks accept Slack-format payloads, so slack_configs is used.
route:
  receiver: mattermost
  group_by: [alertname]
  group_wait: 30s
  group_interval: 10m
  repeat_interval: 12h
receivers:
  - name: mattermost
    slack_configs:
      - api_url_file: /etc/alertmanager/mattermost_webhook
        send_resolved: true
        username: Homelab Alert
        title: '{{ "{{" }} .Status | toUpper {{ "}}" }}{{ "{{" }} if eq .Status "firing" {{ "}}" }}:{{ "{{" }} .Alerts.Firing | len {{ "}}" }}{{ "{{" }} end {{ "}}" }} {{ "{{" }} .CommonLabels.alertname {{ "}}" }} ({{ "{{" }} .CommonLabels.severity {{ "}}" }})'
        text: |-
          {{ "{{" }} range .Alerts {{ "}}" }}{{ "{{" }} if .Annotations.summary {{ "}}" }}{{ "{{" }} .Annotations.summary {{ "}}" }}{{ "{{" }} else {{ "}}" }}{{ "{{" }} .Labels.alertname {{ "}}" }}{{ "{{" }} end {{ "}}" }}{{ "{{" }} if .Annotations.description {{ "}}" }} - {{ "{{" }} .Annotations.description {{ "}}" }}{{ "{{" }} end {{ "}}" }}
          {{ "{{" }} end {{ "}}" }}
        color: '{{ "{{" }} if eq .Status "firing" {{ "}}" }}danger{{ "{{" }} else {{ "}}" }}good{{ "{{" }} end {{ "}}" }}'
{% if backup_alertmanager_pushover_enabled | default(false) %}
    pushover_configs:
      - user_key_file: /etc/alertmanager/pushover_user_key
        token_file: /etc/alertmanager/pushover_token
        send_resolved: false
        html: true
        title: '{{ "{{" }} .Status | toUpper {{ "}}" }}: {{ "{{" }} .CommonLabels.alertname {{ "}}" }}'
        message: |-
          {{ "{{" }} range .Alerts {{ "}}" }}{{ "{{" }} if .Annotations.summary {{ "}}" }}{{ "{{" }} .Annotations.summary {{ "}}" }}{{ "{{" }} else {{ "}}" }}{{ "{{" }} .Labels.alertname {{ "}}" }}{{ "{{" }} end {{ "}}" }}
          {{ "{{" }} end {{ "}}" }}
        priority: '{{ "{{" }} if eq .CommonLabels.severity "critical" {{ "}}" }}1{{ "{{" }} else {{ "}}" }}0{{ "{{" }} end {{ "}}" }}'
        sound: '{{ "{{" }} if eq .CommonLabels.severity "critical" {{ "}}" }}siren{{ "{{" }} else {{ "}}" }}pushover{{ "{{" }} end {{ "}}" }}'
{% endif %}
